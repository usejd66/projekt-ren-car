#: car_app/templates/about.html:7
#, python-format
msgid ""
"%(name)s is a car rental company in %(city)s offering modern cars, clear "
"prices and simple online booking, with pickup in %(locations)s."
msgstr ""
"%(name)s është një kompani me makina me qira në %(city)s, me makina moderne,"
" çmime të qarta dhe rezervim të thjeshtë online, me marrje në %(locations)s."

#: car_app/templates/about.html:14
#, python-format
msgid "About %(name)s"
msgstr "Rreth %(name)s"

#: car_app/templates/about.html:15
#, python-format
msgid ""
"A local car rental company in %(city)s, built around one idea: renting a car"
" should be simple."
msgstr ""
"Një kompani vendase me makina me qira në %(city)s, e ndërtuar mbi një ide: "
"marrja e një makine me qira duhet të jetë e thjeshtë."

#: car_app/templates/about.html:24 car_app/templates/index.html:174
#, python-format
